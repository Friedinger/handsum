{
  "name": "friedinger/handsum-server",
  "description": "Move log server for Handsum. Production code has no dependencies; Composer is only used for the tests.",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": "8.5.*"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "3.95.27",
    "phpstan/phpstan": "2.3.1",
    "phpunit/phpunit": "13.4.3"
  },
  "autoload-dev": {
    "psr-4": {
      "Handsum\\Tests\\": "tests/"
    }
  },
  "config": {
    "platform": {
      "php": "8.5.0"
    },
    "sort-packages": true
  }
}
