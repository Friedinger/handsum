  "repository": {
    "type": "git",
    "url": "git+https://github.com/Friedinger/handsum.git"
  },
  "license": "MIT",
  "author": "Friedinger",
  "scripts": {
    "dev": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "preview": "npm --prefix client run preview",
    "test": "npm --prefix client test",
