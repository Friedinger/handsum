{
  "name": "handsum",
  "description": "Browser-based multiplayer card game prototype for 2 to 8 players, played in the browser via a shared link.",
  "private": true,
  "version": "0.0.0",
  "homepage": "https://github.com/Friedinger/handsum#readme",
  "bugs": {
    "url": "https://github.com/Friedinger/handsum/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Friedinger/handsum.git"
  },
  "license": "MIT",
  "author": "Friedinger",
  "scripts": {
    "client:dev": "npm --prefix client run dev",
    "client:build": "npm --prefix client run build",
    "client:test": "npm --prefix client run test",
    "client:lint": "npm --prefix client run lint",
    "client:fix": "npm --prefix client run fix",
    "server:install": "docker compose run --rm composer install --no-interaction --no-progress",
    "server:dev": "docker compose run --rm --service-ports php-dev",
    "server:test": "npm run server:install && docker compose run --rm php-test",
    "deploy:check": "scripts/check-subfolder-deploy.sh",
    "test": "npm run client:test && npm run server:test",
    "lint": "npm run client:lint",
    "fix": "npm run client:fix"
  }
}
